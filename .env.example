# Optional ARGUS configuration placeholders. Never add real keys here.
# Set a key to enable the OpenAI model cascade; otherwise the local deterministic flow is used.
ARGUS_API_KEY=
ARGUS_MAX_ITERATIONS=4
ARGUS_TOP_K=5
ARGUS_RETRY_LIMIT=2
ARGUS_TOOL_TIMEOUT_SECONDS=10
ARGUS_CONFIDENCE_THRESHOLD=0.75
ARGUS_MINIMUM_SOURCES=2
ARGUS_RISK_WEIGHT_IMPACT=0.40
ARGUS_RISK_WEIGHT_PROBABILITY=0.35
ARGUS_RISK_WEIGHT_URGENCY=0.25
